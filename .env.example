APP_NAME=XZY
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# Database Configuration (PostgreSQL for production, SQLite for local testing)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=xzy_db
DB_USERNAME=postgres
DB_PASSWORD=

# Cache, Queue, and Sessions
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail Configuration (SMTP for real email notifications)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@xzy.test"
MAIL_FROM_NAME="${APP_NAME}"

# Object Storage (MinIO / AWS S3 Compatible)
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=xzy-artifacts
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=

# TokenomixAI Gateway Integration
# Base URL must end with /v1 without trailing slash duplication
TOKENOMIXAI_BASE_URL=https://api.tokenomixai.com/v1
TOKENOMIXAI_API_KEY=

# Genuine RAR Archiver Executable Configuration
# Tentukan path absolut binary command-line RAR/WinRAR resmi jika fitur ekspor RAR ingin diaktifkan
# Contoh Linux: /usr/bin/rar
# Contoh Windows: C:\Program Files\WinRAR\Rar.exe
RAR_BINARY_PATH=
